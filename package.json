{
  "name": "@webship.co/workspace-jira",
  "version": "1.0.15",
  "description": "Jira for Webship Workspace, over the Teamwork Graph CLI (twg): the JIRA menu on every site row, the workitems list, one-workitem modal (analyze, do the work with Claude Code, runs, comment, worklog), agent badges, a New-folder workitem, and the twg session mounted into the dashboard container. It carries its AI items, each placed in the workspace folder of its kind: an agent, a skill, a command and a prompt.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/webship/workspace-jira.git"
  },
  "files": [
    "dist/src",
    "ai",
    "config",
    "ddev",
    "features",
    "public",
    "scripts",
    "host-mounts.txt",
    "README.md",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@webship.co/workspace-plugin-api": "^1.0.2",
    "typescript": "^5.9.0"
  },
  "workspacePlugin": {
    "name": "jira",
    "label": "Jira",
    "needs": {
      "plugins": [
        "ai-agents",
        "ai-skills",
        "ai-commands",
        "ai-prompts"
      ],
      "commands": [
        {
          "command": "twg",
          "hint": "https://developer.atlassian.com/cloud/twg-cli/"
        }
      ]
    },
    "settingsFile": "plugin.jira.settings.yml",
    "settingsTemplate": "config/plugin.jira.settings.yml",
    "labels": "config/settings.labels.yml",
    "legacySettingsKey": "jira",
    "typeActions": {
      "jira": [
        "sites"
      ]
    },
    "scripts": {
      "hostInstall": "scripts/host-install.sh"
    },
    "ddev": {
      "compose": [
        "ddev/docker-compose.twg.yaml"
      ],
      "hostMounts": [
        "~/.config/twg",
        "~/.local/bin"
      ]
    },
    "css": [
      "public/jira.css"
    ],
    "ai": {
      "agents": [
        "ai/agents/jira-workitem-manager.md"
      ],
      "skills": [
        "ai/skills/jira-workitems"
      ],
      "commands": [
        "ai/commands/jira-workitem.md"
      ],
      "prompts": [
        "ai/prompts/jira-open-workitems.md"
      ]
    },
    "features": [
      "features/jira.feature"
    ]
  },
  "publishConfig": {
    "access": "public"
  }
}
