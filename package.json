{
  "name": "@webship.co/workspace-jira",
  "version": "1.0.0-rc1",
  "description": "Jira for Webship Workspace, over the Teamwork Graph CLI (twg): the JIRA menu on every site row, the workitems list, one-workitem modal (analyze, do the work with Claude Code, runs, comment, worklog), agent badges, a New-folder workitem, and the twg session mounted into the dashboard container.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/webship/workspace-jira.git"
  },
  "files": [
    "dist/src",
    "config",
    "ddev",
    "features",
    "public",
    "scripts",
    "host-mounts.txt",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@webship.co/workspace-plugin-api": "^1.0.0-rc1",
    "typescript": "^5.9.0"
  },
  "workspacePlugin": {
    "name": "jira",
    "label": "Jira",
    "settingsFile": "plugin.jira.settings.yml",
    "settingsTemplate": "config/plugin.jira.settings.yml",
    "labels": "config/settings.labels.yml",
    "legacySettingsKey": "jira",
    "typeActions": {
      "jira": [
        "sites"
      ]
    },
    "scripts": {
      "hostInstall": "scripts/host-install.sh"
    },
    "ddev": {
      "compose": [
        "ddev/docker-compose.twg.yaml"
      ],
      "hostMounts": [
        "~/.config/twg",
        "~/.local/bin"
      ]
    },
    "css": [
      "public/jira.css"
    ],
    "features": [
      "features/jira.feature"
    ]
  },
  "publishConfig": {
    "access": "public"
  }
}
